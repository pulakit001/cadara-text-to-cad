# ── Dependencies ──
node_modules/

# ── Secrets ──
.env
.env.local
.env.*.local

# ── Generated output ──
models/
*.log
npm-debug.log*

# ── OS junk ──
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Python ──
__pycache__/
*.pyc
.venv/

# ── Dev review artifacts ──
.impeccable/
.opencode/

# ── Unrelated projects ──
minecraftty/

# ── Electron build output ──
dist/
out/

# ── Generated 3D files at root ──
*.glb
*.step

# ── Vendored libraries (Three.js etc.) ──
vendor/
# ...except the packaged renderer addons: electron-builder drops
# three/examples/ from node_modules, so these must live in the repo.
!cadara/renderer/assets/vendor/
!cadara/renderer/assets/vendor/**

# ── Python egg-info ──
**/*.egg-info/
.aider*
