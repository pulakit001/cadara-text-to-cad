# ── LLM Provider Keys ──
# Add at least one key. Get yours at:
#   Gemini  → https://aistudio.google.com/apikey
#   Groq    → https://console.groq.com/keys
#   OpenAI  → https://platform.openai.com/api-keys
#   Claude  → https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Defaults ──
# Which provider to use by default (gemini | groq | openai | claude | openrouter)
LLM_PROVIDER=gemini

# Optional: lock to a specific model ID (leave blank for auto-select)
LLM_MODEL=

# ── CAD Runtime ──
# Path to the Python 3.10+ binary inside the cad-runtime venv.
# The default assumes you followed the README setup instructions.
CAD_PYTHON=./cad-runtime/.venv/bin/python
