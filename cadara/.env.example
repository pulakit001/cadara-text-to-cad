# ── LLM Provider Keys ──
# Add at least one key. Get yours at:
#   Gemini      → https://aistudio.google.com/apikey
#   Z.AI        → https://z.ai (GLM models)
#   Qwen        → https://bailian.console.alibabacloud.com (DashScope key)
#   OpenAI      → https://platform.openai.com/api-keys
#   Claude      → https://console.anthropic.com/settings/keys
#   OpenRouter  → https://openrouter.ai/keys
GEMINI_API_KEY=
ZAI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Defaults ──
# Which provider to use by default (gemini | zai | qwen | openai | claude | openrouter)
LLM_PROVIDER=gemini

# Optional: lock to a specific model ID (leave blank for auto-select)
LLM_MODEL=

# ── CAD Runtime ──
# Path to a Python 3.12+ binary with build123d installed.
# The default assumes you followed the README setup instructions.
CAD_PYTHON=./cad-runtime/.venv/bin/python
